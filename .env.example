# Tên publication trên Substack, hoặc URL đầy đủ.
SUBSTACK_PUBLICATION=lau1k

# Lấy từ @BotFather sau khi tạo bot.
TELEGRAM_BOT_TOKEN=

# Kênh public dùng @ten_kenh; kênh private dùng id dạng số âm.
TELEGRAM_CHAT_ID=

# Tuỳ chọn: dòng cuối của mỗi tin. {date} thành ngày đăng của bài (YYYY-MM-DD).
MESSAGE_FOOTER=Lẩu 1K • {date}

# Múi giờ dùng để tính {date}. Mặc định Asia/Ho_Chi_Minh.
MESSAGE_TIMEZONE=
